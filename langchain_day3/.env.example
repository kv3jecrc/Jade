# Copy to .env in each assignment folder and fill in real values.
# Never commit an actual .env with real keys.

# ----------------------------------------------------------------------
# Which provider to use. Default is "ollama" per the corporate-IT note.
# ----------------------------------------------------------------------
LLM_PROVIDER=ollama

# ----------------------------------------------------------------------
# Ollama (local, no API key needed) -- used when LLM_PROVIDER=ollama
# ----------------------------------------------------------------------
# Assignment 1 REQUIRES a tool/function-calling-capable model, e.g.:
#   ollama pull llama3.1
# (llama3.2 and qwen2.5 also support tool calling; not every model does)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# Used only by Assignment 3 (embeddings for the vector store):
#   ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# ----------------------------------------------------------------------
# OpenAI -- used when LLM_PROVIDER=openai
# ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------
# Google Gemini -- used when LLM_PROVIDER=google
# ----------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash
GOOGLE_EMBED_MODEL=models/embedding-001
